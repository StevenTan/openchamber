{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["server/lib/agent-command/src/**/*.ts", "server/lib/agent-search/src/**/*.ts", "server/lib/agent-question/src/**/*.ts", "server/lib/agent-collaboration/src/**/*.ts", "server/lib/agent-code-mode/src/**/*.ts"]
}
